# Development-only defaults. Copy this file to .env before starting Sandboxer.
# These credentials are public and must not be reused in production.
MYSQL_ROOT_PASSWORD=superduperroot
MYSQL_DATABASE=sandbox
MYSQL_USER=sandboxer
MYSQL_PASSWORD=localuserpassword
# Dedicated WordPress database and account.
WORDPRESS_DB_NAME=wordpress_sandbox
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=localwordpresspassword

# Dedicated HedgeDoc database and account.
HEDGEDOC_DB_NAME=hedgedoc_sandbox
HEDGEDOC_DB_USER=hedgedoc
HEDGEDOC_DB_PASSWORD=localhedgedocpassword

# Initial local HedgeDoc login password.
HEDGEDOC_PASSWORD=localuserpassword

# Path relative to www/ for the optional Node service.
APP_PATH=laravel
